# Copy to .env (gitignored). Never commit real values.
# Only the scripts below read it: `npm run dev` and `npm run build` need no environment at all,
# and the site's production secrets live in Cloudflare, not here.

# Sanity API token with Editor permission. Used by the import script (`npm run import:wp -- --write`)
# and one-off content scripts. Create it at sanity.io/manage → project → API → Tokens.
SANITY_WRITE_TOKEN=
