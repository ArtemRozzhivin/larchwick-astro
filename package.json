{
  "name": "larchwick-astro",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "preview:deploy": "BRANCH=$(git branch --show-current); [ -n \"$BRANCH\" ] && [ \"$BRANCH\" != main ] || { echo 'preview:deploy runs on a branch other than main' >&2; exit 1; }; WORKERS_CI_BRANCH=\"$BRANCH\" astro build && npx wrangler preview",
    "astro": "astro",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "astro check",
    "verify": "npm run check && npm run lint && npm run format:check && npm test",
    "credits": "node scripts/credits/build-credits.ts",
    "seo:crawl": "node scripts/seo-check/crawl.ts",
    "seo:compare": "node scripts/seo-check/compare.ts",
    "rebuild:watch": "node scripts/rebuild-time/watch.ts",
    "rag:passages": "RAG_INDEX=dry astro build",
    "rag:inspect": "node scripts/rag-eval/inspect.ts",
    "rag:eval": "node scripts/rag-eval/eval.ts",
    "lighthouse:import": "node scripts/lighthouse-import/import.ts",
    "lighthouse:run": "node scripts/lighthouse-run/run.ts",
    "test": "node --test 'worker/**/*.test.ts' 'src/**/*.test.ts'",
    "import:wp": "node --env-file-if-exists=.env scripts/import-wp/import.ts",
    "studio": "npm --prefix studio run dev",
    "studio:typegen": "npm --prefix studio run typegen",
    "prepare": "husky",
    "lint-staged": "lint-staged"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@sanity/image-url": "^2.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "astro-portabletext": "^1.0.1",
    "class-variance-authority": "^0.7.1",
    "groq": "^6.19.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.6.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.3",
    "prettier": "3.5.3",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.astro": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,mjs,yml,yaml}": "prettier --write"
  }
}
