# Cloudflare Workers Static Assets response headers (copied into dist/ by the build).

# Hashed build output (CSS, fonts, images) never changes under the same name.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Production is indexable. Preview builds get X-Robots-Tag: noindex appended by the
# previewNoindex() integration (src/integrations/preview-noindex.ts).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'
