{
  // Must match the Worker name in the Cloudflare dashboard, or Workers Builds refuses to deploy.
  "name": "larchwick-astro",
  "compatibility_date": "2026-10-06",
  // Branch builds run `npx wrangler preview`, which requires this block (empty = defaults).
  "previews": {},
  // Only /api/* reaches the script (the contact form, PLAN.md D-4); every page is a static asset.
  "main": "worker/index.ts",
  "assets": {
    "run_worker_first": ["/api/*"],
    "directory": "./dist",
    // /about → 307 → /about/, matching Astro's trailingSlash: 'always'.
    "html_handling": "force-trailing-slash",
    // Unknown URLs get dist/404.html with a real 404 status.
    "not_found_handling": "404-page",
  },
}
