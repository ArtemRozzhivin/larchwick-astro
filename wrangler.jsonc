{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard, or Workers Builds refuses to deploy.
  "name": "larchwick-astro",
  "compatibility_date": "2026-10-06",
  // Static assets only for now; the /api/contact script arrives in Phase 5c (PLAN.md D-0, D-4).
  "assets": {
    "directory": "./dist",
    // /about → 307 → /about/, matching Astro's trailingSlash: 'always'.
    "html_handling": "force-trailing-slash",
    // Unknown URLs get dist/404.html with a real 404 status.
    "not_found_handling": "404-page",
  },
}
