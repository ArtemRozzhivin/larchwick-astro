---
import { blog } from '@lib/content/blog'
import { formatPostDate } from '@lib/format/date'
import { termPath } from '@lib/routes'
import type { Post } from '@lib/sanity/posts'

interface Props {
  post: Pick<Post, 'publishedAt' | 'categories'>
  byline?: boolean
  class?: string
}

const { post, byline = false, class: className } = Astro.props

const category = post.categories?.[0]
const bylineText = `${blog.bylineLabel} ${blog.byline}`
---

<p class:list={['flex flex-wrap items-center gap-x-3 gap-y-1 text-sm', className]}>
  {
    category && (
      <a
        href={termPath({ _type: 'category', slug: category.slug })}
        class="bg-mist text-larch hover:bg-needle hover:text-espresso rounded-full px-2.5 py-0.5 font-bold transition-colors"
      >
        {category.title}
      </a>
    )
  }
  {post.publishedAt && <time datetime={post.publishedAt}>{formatPostDate(post.publishedAt)}</time>}
  {byline && <span>{bylineText}</span>}
</p>
