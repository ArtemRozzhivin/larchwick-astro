---
import { type Post, postPath } from '@lib/sanity/posts'
import SanityImage from '@components/ui/SanityImage.astro'

import PostMeta from './PostMeta.astro'

interface Props {
  post: Post
  headingLevel?: 'h2' | 'h3'
}

const { post, headingLevel: Heading = 'h2' } = Astro.props
---

<article class="flex flex-col">
  {
    post.mainImage && (
      <a href={postPath(post)} tabindex="-1" aria-hidden="true" class="mb-4 block">
        <SanityImage
          image={post.mainImage}
          widths={[400, 640, 800]}
          sizes="(min-width: 64rem) 24rem, (min-width: 40rem) 50vw, 100vw"
          aspectRatio={3 / 2}
          class="w-full rounded-sm"
        />
      </a>
    )
  }
  <PostMeta post={post} />
  <Heading class="text-heading mt-2 font-serif text-2xl leading-snug text-balance">
    <a href={postPath(post)} class="hover:text-brand-dark">{post.title}</a>
  </Heading>
  {post.excerpt && <p class="mt-2 leading-relaxed text-pretty">{post.excerpt}</p>}
</article>
