---
import { type Post, postPath } from '@lib/sanity/posts'
import SanityImage from '@components/ui/SanityImage.astro'

import PostMeta from './PostMeta.astro'

interface Props {
  post: Post
  headingLevel?: 'h2' | 'h3'
  /** The card's image is the page's largest element (first card of an archive): load it first. */
  priority?: boolean
}

const { post, headingLevel: Heading = 'h2', priority = false } = Astro.props
---

<article class="reveal flex flex-col">
  {
    post.mainImage && (
      <a href={postPath(post)} tabindex="-1" aria-hidden="true" class="mb-4 block">
        <SanityImage
          image={post.mainImage}
          widths={[400, 640, 800]}
          sizes="(min-width: 64rem) 24rem, (min-width: 40rem) 50vw, 100vw"
          aspectRatio={3 / 2}
          priority={priority}
          class="rounded-label w-full"
        />
      </a>
    )
  }
  <PostMeta post={post} />
  <Heading
    class="text-espresso font-display mt-2 text-[1.9rem] leading-none font-extrabold text-balance"
  >
    <a href={postPath(post)} class="hover:text-larch">{post.title}</a>
  </Heading>
  {post.excerpt && <p class="mt-2 leading-relaxed text-pretty">{post.excerpt}</p>}
</article>
