---
/**
 * The "Ask Larchwick" assistant (PLAN.md Phase 7b). Opening and closing is a native popover, like
 * the mobile menu. The script below is a few lines that load
 * the chat module (src/lib/chat/client.ts) the first time the panel opens.
 */
import { CHAT_PANEL_ID } from '@lib/chat/config'
import { answerParts, QUESTION_MAX } from '@lib/chat/stream'
import { chat } from '@lib/content/chat'
import { buttonVariants, iconButtonVariants } from '@components/ui/button'
import { fieldVariants } from '@components/ui/field'
import Icon from '@components/ui/Icon.astro'
import { pillVariants } from '@components/ui/link'

const unavailable = answerParts(chat.failed)
---

<button
  type="button"
  popovertarget={CHAT_PANEL_ID}
  class="chat-launcher bg-needle text-espresso border-espresso hover:bg-espresso hover:text-surface focus-visible:bg-espresso focus-visible:text-surface fixed right-4 bottom-4 z-40 inline-flex size-14 cursor-pointer items-center justify-center gap-2 rounded-full border-2 font-bold transition-colors sm:size-auto sm:px-5 sm:py-3 md:right-6 md:bottom-6"
>
  <Icon name="message-circle" class="size-6 sm:size-5" />
  <span class="sr-only sm:not-sr-only">{chat.button}</span>
</button>

<div
  id={CHAT_PANEL_ID}
  popover
  role="dialog"
  aria-labelledby="chat-title"
  class="chat-panel bg-surface text-ink border-espresso rounded-label shadow-label border-2"
  data-thinking={chat.thinking}
  data-sources={chat.sources}
  data-failed={chat.failed}
>
  <div class="short:h-auto short:min-h-full flex h-full flex-col">
    <div class="border-espresso flex items-center justify-between gap-3 border-b-2 py-3 pr-3 pl-5">
      <h2 id="chat-title" class="font-display text-espresso text-3xl leading-none font-black">
        {chat.title}
      </h2>
      <button
        type="button"
        popovertarget={CHAT_PANEL_ID}
        popovertargetaction="hide"
        class={iconButtonVariants({ size: 'sm' })}
      >
        <span class="sr-only">{chat.close}</span>
        <Icon name="x" class="size-5" />
      </button>
    </div>

    <div
      role="log"
      data-chat-log
      class="short:overflow-visible flex flex-1 flex-col gap-3 overflow-y-auto px-5 py-4"
    >
      <p class="leading-relaxed text-pretty">{chat.intro}</p>
      <div data-chat-suggestions>
        <p class="text-sm font-bold">{chat.suggestionsLabel}</p>
        <ul class="mt-2 flex flex-wrap gap-2">
          {
            chat.suggestions.map((suggestion) => (
              <li>
                <button type="button" data-suggestion class={pillVariants({ as: 'button' })}>
                  {suggestion}
                </button>
              </li>
            ))
          }
        </ul>
      </div>
      <noscript>
        <p class="text-stamp font-bold">
          {chat.noScript}
          <a href={chat.noScriptLink.href} class="underline underline-offset-4">
            {chat.noScriptLink.label}
          </a>
        </p>
      </noscript>
      <p data-chat-unavailable hidden class="text-stamp font-bold">
        {
          unavailable.map((part) =>
            part.href ? (
              <a href={part.href} class="underline underline-offset-4">
                {part.text}
              </a>
            ) : (
              part.text
            ),
          )
        }
      </p>
    </div>

    <form data-chat-form class="border-border border-t px-5 pt-3 pb-4">
      <label for="chat-question" class="sr-only">{chat.label}</label>
      <fieldset disabled data-chat-controls class="flex min-w-0 gap-2">
        <input
          id="chat-question"
          name="question"
          type="text"
          required
          maxlength={QUESTION_MAX}
          autocomplete="off"
          placeholder={chat.placeholder}
          class={fieldVariants({ size: 'sm', class: 'min-w-0 flex-1' })}
        />
        <button type="submit" class={buttonVariants({ variant: 'primary', size: 'sm' })}>
          <Icon name="send" />
          <span class="sr-only">{chat.send}</span>
        </button>
      </fieldset>
      <p class="mt-2 text-xs leading-snug text-pretty">{chat.note}</p>
    </form>
  </div>
</div>

<script>
  import { track } from '../../lib/analytics/track'
  import { CHAT_PANEL_ID } from '../../lib/chat/config'

  const panel = document.getElementById(CHAT_PANEL_ID)
  if (panel) {
    // A native submit is a GET with the question in the URL, and so in analytics' page_view. The
    // controls are rendered disabled and enabled only once this listener cancels that submit.
    panel.querySelector('form')?.addEventListener('submit', (event) => event.preventDefault())
    const controls = panel.querySelector<HTMLFieldSetElement>('[data-chat-controls]')
    if (controls) controls.disabled = false
    panel.addEventListener('toggle', (event) => {
      if (event.newState !== 'open') return
      track('chat_open')
      import('../../lib/chat/client')
        .then(({ startChat }) => startChat(panel))
        .catch(() => {
          const message = panel.querySelector<HTMLElement>('[data-chat-unavailable]')
          if (message) message.hidden = false
        })
    })
  }
</script>
