---
import type { IconName } from '@lib/types'

type IconNode =
  | readonly ['path', { readonly d: string }]
  | readonly ['circle', { readonly cx: string; readonly cy: string; readonly r: string }]
  | readonly [
      'rect',
      {
        readonly x: string
        readonly y: string
        readonly width: string
        readonly height: string
        readonly rx: string
      },
    ]

interface Props {
  name: IconName
  class?: string
}

const { name, class: className = 'size-6' } = Astro.props

// Icon nodes copied from Lucide 0.563.0 (https://lucide.dev, ISC); the licence notice is in CREDITS.md.
const ICONS: Record<IconName, readonly IconNode[]> = {
  coffee: [
    ['path', { d: 'M10 2v2' }],
    ['path', { d: 'M14 2v2' }],
    [
      'path',
      {
        d: 'M16 8a1 1 0 0 1 1 1v8a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V9a1 1 0 0 1 1-1h14a4 4 0 1 1 0 8h-1',
      },
    ],
    ['path', { d: 'M6 2v2' }],
  ],
  'chevron-down': [['path', { d: 'm6 9 6 6 6-6' }]],
  menu: [
    ['path', { d: 'M4 5h16' }],
    ['path', { d: 'M4 12h16' }],
    ['path', { d: 'M4 19h16' }],
  ],
  x: [
    ['path', { d: 'M18 6 6 18' }],
    ['path', { d: 'm6 6 12 12' }],
  ],
}

const nodes = ICONS[name]
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}
>
  {nodes.map(([Tag, attrs]) => <Tag {...attrs} />)}
</svg>
