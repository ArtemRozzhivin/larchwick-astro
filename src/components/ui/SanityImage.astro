---
import { Picture } from 'astro:assets'

import { getImagePlaceholders, imageSource, type SanityImageValue } from '@lib/sanity/image'

interface Props {
  image: SanityImageValue
  widths: readonly number[]
  sizes: string
  aspectRatio?: number
  priority?: boolean
  class?: string
}

const { image, widths, sizes, aspectRatio, priority = false, class: className } = Astro.props

const { src, width, height } = imageSource(image, Math.max(...widths), aspectRatio)
const usableWidths = widths.filter((candidate) => candidate <= width)
const alt = image.decorative ? '' : (image.alt ?? '')
const placeholders = await getImagePlaceholders()
const placeholder = image.asset ? placeholders.get(image.asset._ref) : undefined
const placeholderStyle = placeholder ? `background-image: url(${placeholder})` : undefined
// AVIF's scale: 50 looks like 75 does in JPEG or WebP, at about half the bytes (PLAN.md Phase 8).
const QUALITY = 50
---

<Picture
  src={src}
  width={width}
  height={height}
  widths={usableWidths.length > 0 ? usableWidths : [width]}
  sizes={sizes}
  formats={['avif', 'webp']}
  fallbackFormat="jpg"
  quality={QUALITY}
  alt={alt}
  priority={priority}
  class:list={[className, placeholder && 'bg-cover bg-center']}
  style={placeholderStyle}
/>
