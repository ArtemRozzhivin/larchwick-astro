---
import { buttonVariants } from '@components/ui/button'

import Section from './Section.astro'

interface Cta {
  label: string
  href: string
}

interface Props {
  id?: string
  title: string
  subtitle?: string
  primaryCta?: Cta
  secondaryCta?: Cta
}

const { id = 'cta', title, subtitle, primaryCta, secondaryCta } = Astro.props

const hasCtas = Boolean(primaryCta || secondaryCta)
---

<Section id={id} title={title} subtitle={subtitle} tone="muted">
  {
    hasCtas && (
      <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
        {primaryCta && (
          <a href={primaryCta.href} class={buttonVariants({ variant: 'primary', size: 'lg' })}>
            {primaryCta.label}
          </a>
        )}
        {secondaryCta && (
          <a href={secondaryCta.href} class={buttonVariants({ variant: 'secondary', size: 'lg' })}>
            {secondaryCta.label}
          </a>
        )}
      </div>
    )
  }
</Section>
