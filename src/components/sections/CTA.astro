---
import { buttonVariants } from '@components/ui/button'

import Section, { type Tone } from './Section.astro'

interface Cta {
  label?: string
  href?: string
}

interface Props {
  id?: string
  heading?: string
  text?: string
  primaryCta?: Cta
  secondaryCta?: Cta
  tone?: Tone
}

const { id = 'cta', heading, text, primaryCta, secondaryCta, tone = 'muted' } = Astro.props

const ctas = [primaryCta, secondaryCta].filter((cta) => cta?.href && cta.label)
---

<Section id={id} heading={heading} intro={text} tone={tone}>
  {
    ctas.length > 0 && (
      <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
        {ctas.map((cta, index) => (
          <a
            href={cta?.href}
            class={buttonVariants({ variant: index === 0 ? 'primary' : 'secondary', size: 'lg' })}
          >
            {cta?.label}
          </a>
        ))}
      </div>
    )
  }
</Section>
