---
import type { SanityImageValue } from '@lib/sanity/image'
import type { BlockContent } from '@lib/sanity/sanity.types'
import { isUsableLink, type Link } from '@lib/types'
import RichText from '@components/rich-text/RichText.astro'
import { buttonVariants } from '@components/ui/button'
import SanityImage from '@components/ui/SanityImage.astro'

import Section, { type LightTone } from './Section.astro'
import SectionHeader from './SectionHeader.astro'

interface Props {
  id?: string
  eyebrow?: string
  heading?: string
  body?: BlockContent
  image?: SanityImageValue
  imagePosition?: 'left' | 'right'
  cta?: Link
  tone?: LightTone
}

const { id, eyebrow, heading, body = [], image, imagePosition = 'left', cta, tone } = Astro.props
---

<Section id={id} tone={tone}>
  <div class="grid items-center gap-10 md:grid-cols-2 md:gap-14">
    {
      /* sizes = (container-wide 76rem - 2 x 2rem padding - md:gap-14 3.5rem) / 2: change with either */
    }
    {
      image && (
        <SanityImage
          image={image}
          widths={[480, 720, 960, 1280]}
          sizes="(min-width: 76rem) 34.25rem, (min-width: 48rem) calc(50vw - 3.75rem), 100vw"
          aspectRatio={4 / 3}
          class:list={[
            'reveal border-espresso rounded-photo w-full border-2',
            imagePosition === 'right' && 'md:order-last',
          ]}
        />
      )
    }
    <div>
      <SectionHeader eyebrow={eyebrow} heading={heading} tone={tone} revealDelay={1} />
      <RichText value={body} class="mt-5 text-lg" />
      {
        isUsableLink(cta) && (
          <a
            href={cta.href}
            class:list={['reveal mt-8', buttonVariants({ variant: 'secondary' })]}
            style="--reveal-delay: 3"
          >
            {cta.label}
          </a>
        )
      }
    </div>
  </div>
</Section>
