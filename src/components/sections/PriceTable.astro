---
import type { PriceTable } from '@lib/sanity/sanity.types'

import Section, { type LightTone } from './Section.astro'

type Row = Pick<NonNullable<PriceTable['rows']>[number], 'name' | 'description' | 'price'>

interface Props {
  id?: string
  eyebrow?: string
  heading?: string
  intro?: string
  rows: readonly Row[]
  note?: string
  tone?: LightTone
}

const { id, eyebrow, heading, intro, rows, note, tone } = Astro.props
---

<Section id={id} eyebrow={eyebrow} heading={heading} intro={intro} tone={tone} width="narrow">
  <dl class="divide-border border-y">
    {
      rows.map((row) => (
        <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-4">
          <dt>
            <span class="text-espresso font-semibold">{row.name}</span>
            {row.description && <span class="block text-sm">{row.description}</span>}
          </dt>
          <dd class="text-larch font-display text-2xl font-black">{row.price}</dd>
        </div>
      ))
    }
  </dl>
  {note && <p class="mt-4 text-sm">{note}</p>}
</Section>
