---
import { buttonVariants } from '@components/ui/button'
import Icon from '@components/ui/Icon.astro'

interface Cta {
  label: string
  href: string
}

interface Props {
  id?: string
  eyebrow?: string
  title: string
  subtitle?: string
  primaryCta?: Cta
  secondaryCta?: Cta
  points?: readonly string[]
}

const { id = 'hero', eyebrow, title, subtitle, primaryCta, secondaryCta, points = [] } = Astro.props

const hasCtas = Boolean(primaryCta || secondaryCta)
---

<section id={id} class="bg-dark text-subtle py-16 md:py-24">
  <div class="container-wide">
    <div class="max-w-2xl">
      {
        eyebrow && (
          <p class="text-brand mb-5 text-sm font-semibold tracking-widest text-balance uppercase">
            {eyebrow}
          </p>
        )
      }

      <h1
        class="text-surface font-serif text-4xl leading-tight text-balance sm:text-5xl lg:text-[3.5rem]"
      >
        {title}
      </h1>

      {subtitle && <p class="mt-6 text-lg leading-relaxed text-pretty">{subtitle}</p>}

      {
        hasCtas && (
          <div class="mt-9 flex flex-col gap-3 sm:flex-row">
            {primaryCta && (
              <a href={primaryCta.href} class={buttonVariants({ variant: 'inverse', size: 'lg' })}>
                {primaryCta.label}
              </a>
            )}
            {secondaryCta && (
              <a
                href={secondaryCta.href}
                class={buttonVariants({ variant: 'inverse-outline', size: 'lg' })}
              >
                {secondaryCta.label}
              </a>
            )}
          </div>
        )
      }

      {
        points.length > 0 && (
          <ul class="mt-8 flex flex-col gap-x-6 gap-y-2 text-sm sm:flex-row sm:flex-wrap">
            {points.map((point) => (
              <li class="flex items-center gap-2">
                <Icon name="check" class="text-brand size-4 shrink-0" />
                {point}
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <slot />
  </div>
</section>
