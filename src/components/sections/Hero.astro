---
import type { SanityImageValue } from '@lib/sanity/image'
import { getSiteSettings } from '@lib/sanity/settings'
import { buttonVariants } from '@components/ui/button'
import CoffeeLabel, { type CoffeeLabelValue } from '@components/ui/CoffeeLabel.astro'
import Icon from '@components/ui/Icon.astro'
import SanityImage from '@components/ui/SanityImage.astro'

interface Cta {
  label?: string
  href?: string
}

interface Props {
  id?: string
  variant?: 'cover' | 'banner'
  eyebrow?: string
  heading?: string
  text?: string
  image?: SanityImageValue
  label?: CoffeeLabelValue
  primaryCta?: Cta
  secondaryCta?: Cta
  trustList?: readonly string[]
  priority?: boolean
}

const {
  id = 'hero',
  variant = 'cover',
  eyebrow,
  heading,
  text,
  image,
  label,
  primaryCta,
  secondaryCta,
  trustList = [],
  priority = false,
} = Astro.props

const { siteName } = await getSiteSettings()
const isCover = variant === 'cover'
const ctas = [primaryCta, secondaryCta].filter((cta) => cta?.href && cta.label)
const photo = !label && image ? { ...image, decorative: true } : undefined
const hasLabel = Boolean(label?.name)
---

<section
  id={id}
  class:list={[
    'bg-larch text-mist rounded-b-band relative overflow-hidden',
    photo && 'lg:flex lg:min-h-[32rem] lg:items-center',
  ]}
>
  <div
    class:list={[
      'container-wide grid items-center gap-12',
      isCover ? 'py-16 md:py-24' : 'py-14 md:py-20',
      hasLabel && 'lg:grid-cols-[1.15fr_1fr]',
    ]}
  >
    <div class:list={[photo && 'lg:w-1/2 lg:pr-12']}>
      {
        eyebrow && (
          <p class="text-needle rise-in mb-4 font-bold text-balance" style="--rise-delay: 0">
            {eyebrow}
          </p>
        )
      }
      <h1
        class:list={[
          'font-display text-surface rise-in leading-[0.88] font-black text-balance',
          isCover
            ? 'text-[3.6rem] sm:text-7xl xl:text-[6.75rem]'
            : 'text-[3.2rem] sm:text-6xl lg:text-7xl',
        ]}
        style="--rise-delay: 1"
      >
        {heading}
      </h1>

      {
        text && (
          <p
            class="rise-in mt-6 max-w-xl text-lg leading-relaxed text-pretty md:text-xl"
            style="--rise-delay: 2"
          >
            {text}
          </p>
        )
      }

      {
        ctas.length > 0 && (
          <div class="rise-in mt-9 flex flex-col gap-3 sm:flex-row" style="--rise-delay: 3">
            {ctas.map((cta, index) => (
              <a
                href={cta?.href}
                class={buttonVariants({
                  variant: index === 0 ? 'accent' : 'inverse-outline',
                  size: 'lg',
                })}
                data-track="cta_click"
                data-track-cta-label={cta?.label}
                data-track-cta-location="hero"
              >
                {cta?.label}
              </a>
            ))}
          </div>
        )
      }

      {
        trustList.length > 0 && (
          <ul
            class="rise-in mt-8 flex flex-col gap-x-6 gap-y-2 sm:flex-row sm:flex-wrap"
            style="--rise-delay: 4"
          >
            {trustList.map((point) => (
              <li class="flex items-center gap-2">
                <Icon name="check" class="text-needle size-4 shrink-0" />
                {point}
              </li>
            ))}
          </ul>
        )
      }
    </div>

    {
      label && hasLabel && (
        <CoffeeLabel label={label} brand={siteName} class="rise-in" style="--rise-delay: 3" />
      )
    }
  </div>
  {
    photo && (
      <div class="overflow-hidden lg:absolute lg:inset-y-0 lg:right-0 lg:w-1/2">
        <SanityImage
          image={photo}
          widths={[640, 960, 1280, 1600]}
          sizes="(min-width: 64rem) 50vw, 100vw"
          aspectRatio={4 / 3}
          priority={priority}
          class="unveil h-64 w-full object-cover sm:h-96 lg:absolute lg:inset-0 lg:h-full"
        />
      </div>
    )
  }
</section>
