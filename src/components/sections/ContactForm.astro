---
import { siteConfig } from '@lib/config/site'
import { LIMITS } from '@lib/contact/limits'
import { contactForm as copy } from '@lib/content/contact'
import { contactDetails, getSiteSettings } from '@lib/sanity/settings'
import { buttonVariants } from '@components/ui/button'
import { fieldVariants } from '@components/ui/field'
import Icon from '@components/ui/Icon.astro'

import { itemHeading } from './heading'
import Section, { type LightTone } from './Section.astro'

interface Props {
  id?: string
  heading?: string
  intro?: string
  showContactDetails?: boolean
  tone?: LightTone
}

const { id, heading, intro, showContactDetails = true, tone } = Astro.props

const { contact } = await getSiteSettings()
const labels = { ...siteConfig.footer.labels, hours: siteConfig.footer.headings.hours }
const details = contactDetails(contact, siteConfig.footer.labels)
const messageLabel = copy.message(new Intl.NumberFormat(siteConfig.lang).format(LIMITS.message))
const DetailHeading = itemHeading(heading)
const fieldClass = fieldVariants({ class: 'mt-1.5 block w-full' })
const labelClass = 'text-espresso font-bold'
const detailHeadingClass = 'text-espresso font-display text-2xl leading-none font-extrabold'
---

<Section id={id} heading={heading} intro={intro} tone={tone}>
  <div class:list={['grid gap-12', showContactDetails && 'lg:grid-cols-[1fr_20rem]']}>
    <form method="post" action="/api/contact" class="reveal space-y-5">
      <div class="grid gap-5 sm:grid-cols-2">
        <label class={labelClass}>
          {copy.name}
          <input
            name="name"
            type="text"
            autocomplete="name"
            required
            maxlength={LIMITS.name}
            class={fieldClass}
          />
        </label>
        <label class={labelClass}>
          {copy.email}
          <input
            name="email"
            type="email"
            autocomplete="email"
            required
            maxlength={LIMITS.email}
            class={fieldClass}
          />
        </label>
      </div>
      <label class:list={[labelClass, 'block']}>
        {copy.subject}
        <input name="subject" type="text" required maxlength={LIMITS.subject} class={fieldClass} />
      </label>
      <label class:list={[labelClass, 'block']}>
        {messageLabel}
        <textarea name="message" rows="6" maxlength={LIMITS.message} class={fieldClass}></textarea>
      </label>
      <div class="hidden" aria-hidden="true">
        <label>
          {copy.honeypot}
          <input name="website" type="text" tabindex="-1" autocomplete="off" />
        </label>
      </div>
      <button type="submit" class={buttonVariants({ variant: 'primary', size: 'lg' })}>
        {copy.submit}
      </button>
    </form>

    {
      showContactDetails && (
        <address
          style="--reveal-delay: 1"
          class="reveal bg-surface border-espresso shadow-label rounded-label space-y-6 self-start border-2 p-6 not-italic"
        >
          {details.map((detail) => (
            <div>
              <DetailHeading class={detailHeadingClass}>{detail.label}</DetailHeading>
              <p class="mt-1 flex items-center gap-2">
                <Icon name={detail.icon} class="text-larch size-4 shrink-0" />
                <a href={detail.href} class="underline underline-offset-4">
                  {detail.value}
                </a>
              </p>
            </div>
          ))}
          {contact.hours.length > 0 && (
            <div>
              <DetailHeading class={detailHeadingClass}>{labels.hours}</DetailHeading>
              <ul class="mt-1 space-y-1">
                {contact.hours.map((line) => (
                  <li class="flex items-center gap-2">
                    <Icon name="clock" class="text-larch size-4 shrink-0" />
                    {line}
                  </li>
                ))}
              </ul>
            </div>
          )}
        </address>
      )
    }
  </div>
</Section>
