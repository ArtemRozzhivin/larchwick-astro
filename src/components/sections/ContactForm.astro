---
import { siteConfig } from '@lib/config/site'
import { buttonVariants } from '@components/ui/button'
import Icon from '@components/ui/Icon.astro'

import Section, { type Tone } from './Section.astro'

interface Props {
  id?: string
  heading?: string
  intro?: string
  showContactDetails?: boolean
  tone?: Tone
}

const { id = 'contact', heading, intro, showContactDetails = true, tone } = Astro.props

const { contact } = siteConfig
const fieldClass =
  'border-border bg-surface text-heading focus-visible:outline-brand-dark mt-1.5 block w-full rounded-sm border px-3.5 py-2.5'
const labelClass = 'text-heading text-sm font-medium'
---

<Section id={id} heading={heading} intro={intro} tone={tone}>
  <div class:list={['grid gap-12', showContactDetails && 'lg:grid-cols-[1fr_20rem]']}>
    <form method="post" action="/api/contact" class="space-y-5">
      <div class="grid gap-5 sm:grid-cols-2">
        <label class={labelClass}>
          Your name
          <input name="name" type="text" autocomplete="name" required class={fieldClass} />
        </label>
        <label class={labelClass}>
          Your email
          <input name="email" type="email" autocomplete="email" required class={fieldClass} />
        </label>
      </div>
      <label class:list={[labelClass, 'block']}>
        Subject
        <input name="subject" type="text" required class={fieldClass} />
      </label>
      <label class:list={[labelClass, 'block']}>
        Your message (optional)
        <textarea name="message" rows="6" class={fieldClass}></textarea>
      </label>
      <div class="hidden" aria-hidden="true">
        <label>
          Leave this field empty
          <input name="website" type="text" tabindex="-1" autocomplete="off" />
        </label>
      </div>
      <button type="submit" class={buttonVariants({ variant: 'primary', size: 'lg' })}>
        Send message
      </button>
    </form>

    {
      showContactDetails && (
        <address class="space-y-6 not-italic">
          <div>
            <h2 class="text-heading font-serif text-xl">Email</h2>
            <p class="mt-1 flex items-center gap-2">
              <Icon name="mail" class="text-brand-dark size-4 shrink-0" />
              <a href={`mailto:${contact.email}`} class="underline underline-offset-4">
                {contact.email}
              </a>
            </p>
          </div>
          <div>
            <h2 class="text-heading font-serif text-xl">Phone</h2>
            <p class="mt-1 flex items-center gap-2">
              <Icon name="phone" class="text-brand-dark size-4 shrink-0" />
              <a
                href={`tel:${contact.phone.replace(/\s/g, '')}`}
                class="underline underline-offset-4"
              >
                {contact.phone}
              </a>
            </p>
          </div>
          <div>
            <h2 class="text-heading font-serif text-xl">Opening hours</h2>
            <ul class="mt-1 space-y-1">
              {contact.hours.map((line) => (
                <li class="flex items-center gap-2">
                  <Icon name="clock" class="text-brand-dark size-4 shrink-0" />
                  {line}
                </li>
              ))}
            </ul>
          </div>
          <div>
            <h2 class="text-heading font-serif text-xl">Wholesale enquiries</h2>
            <p class="mt-1 flex items-center gap-2">
              <Icon name="mail" class="text-brand-dark size-4 shrink-0" />
              <a href={`mailto:${contact.wholesaleEmail}`} class="underline underline-offset-4">
                {contact.wholesaleEmail}
              </a>
            </p>
          </div>
        </address>
      )
    }
  </div>
</Section>
