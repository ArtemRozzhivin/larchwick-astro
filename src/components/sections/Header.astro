---
/**
 * The mobile menu is built on <details>/<summary>: no JavaScript and no
 * hydration, so it costs nothing on load.
 */
import { getSiteSettings } from '@lib/sanity/settings'
import Icon from '@components/ui/Icon.astro'

type AriaCurrent = 'page' | 'true' | undefined

const currentPath = Astro.url.pathname.replace(/\/?$/, '/')

function getAriaCurrent(href: string): AriaCurrent {
  if (currentPath === href) return 'page'
  if (href !== '/' && currentPath.startsWith(href)) return 'true'
  return undefined
}

const settings = await getSiteSettings()
const navItems = settings.navigation.map((item) => ({
  ...item,
  current: getAriaCurrent(item.href),
}))

const LINK_BASE =
  'rounded-sm decoration-2 underline-offset-8 transition-colors hover:text-brand-dark aria-[current]:text-brand-dark aria-[current]:underline aria-[current]:decoration-brand'
---

<header class="border-border bg-surface relative border-b">
  <div class="container-wide flex h-16 items-center justify-between gap-6 md:h-20">
    <a href="/" class="text-heading rounded-sm font-serif text-2xl leading-none md:text-[1.75rem]">
      {settings.siteName}
    </a>

    <nav aria-label="Main" class="hidden md:block">
      <ul class="flex items-center gap-x-5 lg:gap-x-8">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={item.current}
                class:list={[LINK_BASE, 'text-[0.9375rem] font-medium']}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <details class="group md:hidden">
      <summary
        class="text-heading hover:bg-subtle flex size-11 cursor-pointer list-none items-center justify-center rounded-sm transition-colors [&::-webkit-details-marker]:hidden"
      >
        <span class="sr-only">Menu</span>
        <Icon name="menu" class="size-6 group-open:hidden" />
        <Icon name="x" class="hidden size-6 group-open:block" />
      </summary>

      <div class="border-border bg-surface shadow-card absolute inset-x-0 top-full z-40 border-b">
        <nav aria-label="Main" class="container-wide py-3">
          <ul class="divide-border divide-y">
            {
              navItems.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={item.current}
                    class:list={[LINK_BASE, 'text-heading block py-3 text-base font-medium']}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </details>
  </div>
</header>
