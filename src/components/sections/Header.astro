---
/**
 * The mobile menu is a native popover (popovertarget): no JavaScript, and the browser handles
 * Escape, outside clicks and focus. It slides in as a sidebar (.drawer in global.css).
 */
import { siteConfig } from '@lib/config/site'
import { getSiteSettings } from '@lib/sanity/settings'
import Icon from '@components/ui/Icon.astro'

type AriaCurrent = 'page' | 'true' | undefined

const currentPath = Astro.url.pathname.replace(/\/?$/, '/')

function getAriaCurrent(href: string): AriaCurrent {
  if (currentPath === href) return 'page'
  if (href !== '/' && currentPath.startsWith(href)) return 'true'
  return undefined
}

const settings = await getSiteSettings()
const navItems = settings.navigation.map((item) => ({
  ...item,
  current: getAriaCurrent(item.href),
}))

const { labels } = siteConfig.header
const MENU_ID = 'site-menu'
const ICON_BUTTON =
  'text-espresso hover:bg-paper flex size-11 cursor-pointer items-center justify-center rounded-md transition-colors'

const LINK_BASE =
  'rounded-sm border-b-3 border-transparent pb-1 transition-colors hover:border-needle aria-[current]:border-larch'
---

<header class="bg-paper/95 border-espresso/15 sticky top-0 z-50 border-b backdrop-blur-sm">
  <div class="container-wide flex h-16 items-center justify-between gap-6 md:h-20">
    <a href="/" class="text-larch font-display rounded-sm text-[1.9rem] leading-none font-black">
      {settings.siteName}
    </a>

    <nav aria-label="Main" class="hidden md:block">
      <ul class="flex items-center gap-x-5 lg:gap-x-8">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={item.current}
                class:list={[LINK_BASE, 'text-espresso font-medium']}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button type="button" popovertarget={MENU_ID} class:list={[ICON_BUTTON, 'md:hidden']}>
      <span class="sr-only">{labels.openMenu}</span>
      <Icon name="menu" class="size-6" />
    </button>

    <div id={MENU_ID} popover class="drawer bg-surface text-espresso md:hidden">
      <div class="border-espresso flex h-16 items-center justify-between border-b-2 pr-3 pl-6">
        <span
          aria-hidden="true"
          class="text-larch font-display text-[1.9rem] leading-none font-black"
        >
          {settings.siteName}
        </span>
        <button
          type="button"
          popovertarget={MENU_ID}
          popovertargetaction="hide"
          class:list={[ICON_BUTTON, 'hover:bg-border']}
        >
          <span class="sr-only">{labels.closeMenu}</span>
          <Icon name="x" class="size-6" />
        </button>
      </div>
      <nav aria-label="Main" class="px-6 py-4">
        <ul class="divide-border divide-y">
          {
            navItems.map((item, index) => (
              <li style={`--item: ${index}`}>
                <a
                  href={item.href}
                  aria-current={item.current}
                  class="font-display aria-[current]:text-larch block py-3 text-[2.1rem] leading-none font-extrabold underline-offset-6 aria-[current]:underline aria-[current]:decoration-3"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</header>
