---
import Section, { type Tone } from './Section.astro'

interface Step {
  _key?: string
  title?: string
  text?: string
}

interface Props {
  id?: string
  eyebrow?: string
  heading?: string
  intro?: string
  items: readonly Step[]
  tone?: Tone
}

const { id, eyebrow, heading, intro, items, tone } = Astro.props

const StepHeading = heading ? 'h3' : 'h2'
---

<Section id={id} eyebrow={eyebrow} heading={heading} intro={intro} tone={tone} width="narrow">
  <ol class="space-y-8">
    {
      items.map((item, index) => (
        <li class="flex gap-5">
          <span
            class="border-brand-dark text-brand-dark flex size-10 shrink-0 items-center justify-center rounded-full border-2 font-serif text-lg"
            aria-hidden="true"
          >
            {index + 1}
          </span>
          <div class="pt-1.5">
            <StepHeading class="text-heading font-serif text-xl">{item.title}</StepHeading>
            {item.text && <p class="mt-1 leading-relaxed text-pretty">{item.text}</p>}
          </div>
        </li>
      ))
    }
  </ol>
</Section>
