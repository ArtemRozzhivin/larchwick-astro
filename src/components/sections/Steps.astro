---
import Section, { type Tone } from './Section.astro'

interface Step {
  _key?: string
  title?: string
  text?: string
}

interface Props {
  id?: string
  eyebrow?: string
  heading?: string
  intro?: string
  items: readonly Step[]
  tone?: Tone
}

const { id, eyebrow, heading, intro, items, tone } = Astro.props

const StepHeading = heading ? 'h3' : 'h2'
---

<Section id={id} eyebrow={eyebrow} heading={heading} intro={intro} tone={tone} width="narrow">
  <ol class="space-y-8">
    {
      items.map((item, index) => (
        <li class="reveal flex gap-5">
          <span
            class="bg-needle text-espresso font-display flex size-12 shrink-0 items-center justify-center rounded-full text-2xl font-black"
            aria-hidden="true"
          >
            {index + 1}
          </span>
          <div class="pt-1">
            <StepHeading class="font-display text-espresso text-[1.75rem] leading-none font-extrabold">
              {item.title}
            </StepHeading>
            {item.text && <p class="mt-1 leading-relaxed text-pretty">{item.text}</p>}
          </div>
        </li>
      ))
    }
  </ol>
</Section>
