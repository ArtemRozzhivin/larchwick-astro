---
import type { Stats } from '@lib/sanity/sanity.types'

import Section, { type LightTone } from './Section.astro'

type Stat = Pick<NonNullable<Stats['items']>[number], 'value' | 'label'>

interface Props {
  id?: string
  eyebrow?: string
  heading?: string
  items: readonly Stat[]
  tone?: LightTone
}

const { id, eyebrow, heading, items, tone } = Astro.props

const gridClass = items.length === 4 ? 'grid-cols-2 lg:grid-cols-4' : 'grid-cols-2 md:grid-cols-3'
---

<Section id={id} eyebrow={eyebrow} heading={heading} tone={tone}>
  <dl class:list={['grid gap-x-6 gap-y-10', gridClass]}>
    {
      items.map((item, index) => (
        <div class="reveal flex flex-col-reverse gap-1" style={`--reveal-delay: ${index}`}>
          <dt class="text-pretty">{item.label}</dt>
          <dd class="text-larch font-display text-6xl leading-none font-black md:text-7xl">
            {item.value}
          </dd>
        </div>
      ))
    }
  </dl>
</Section>
