---
import Section, { type Tone } from './Section.astro'

interface Stat {
  _key?: string
  value?: string
  label?: string
}

interface Props {
  id?: string
  eyebrow?: string
  heading?: string
  items: readonly Stat[]
  tone?: Tone
}

const { id, eyebrow, heading, items, tone } = Astro.props

const gridClass = items.length === 4 ? 'grid-cols-2 lg:grid-cols-4' : 'grid-cols-2 md:grid-cols-3'
---

<Section id={id} eyebrow={eyebrow} heading={heading} tone={tone}>
  <dl class:list={['grid gap-x-6 gap-y-10 text-center', gridClass]}>
    {
      items.map((item) => (
        <div class="flex flex-col-reverse gap-2">
          <dt class="text-pretty">{item.label}</dt>
          <dd class="text-brand-dark font-serif text-4xl md:text-5xl">{item.value}</dd>
        </div>
      ))
    }
  </dl>
</Section>
