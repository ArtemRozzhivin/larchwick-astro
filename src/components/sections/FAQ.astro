---
/**
 * Uses native <details>/<summary>, so the accordion works with zero JavaScript
 * and stays keyboard accessible for free.
 */
import type { Faq } from '@lib/sanity/sanity.types'
import RichText from '@components/rich-text/RichText.astro'
import Icon from '@components/ui/Icon.astro'

import { itemHeading } from './heading'
import Section, { type LightTone } from './Section.astro'

type FaqGroup = Pick<NonNullable<Faq['groups']>[number], 'heading' | 'items'>

interface Props {
  id?: string
  eyebrow?: string
  heading?: string
  intro?: string
  groups: readonly FaqGroup[]
  tone?: LightTone
}

const { id, eyebrow, heading, intro, groups, tone } = Astro.props

const GroupHeading = itemHeading(heading)
---

<Section id={id} eyebrow={eyebrow} heading={heading} intro={intro} tone={tone} width="narrow">
  <div class="space-y-12">
    {
      groups.map((group) => (
        <div>
          {group.heading && (
            <GroupHeading class="text-espresso font-display reveal mb-4 text-[2.2rem] leading-none font-black md:text-5xl">
              {group.heading}
            </GroupHeading>
          )}
          <div
            style="--reveal-delay: 1"
            class="reveal divide-border bg-surface border-espresso rounded-label divide-y overflow-hidden border-2"
          >
            {(group.items ?? []).map((item) => (
              <details class="group px-5 py-4 md:px-6 md:py-5">
                <summary class="text-espresso flex cursor-pointer list-none items-center justify-between gap-4 rounded-sm text-lg font-bold [&::-webkit-details-marker]:hidden">
                  {item.question}
                  <Icon
                    name="chevron-down"
                    class="text-larch size-6 shrink-0 transition-transform group-open:rotate-180 motion-reduce:transition-none"
                  />
                </summary>
                {item.answer && <RichText value={item.answer} class="mt-3" />}
              </details>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</Section>
