---
/**
 * Uses native <details>/<summary>, so the accordion works with zero JavaScript
 * and stays keyboard accessible for free.
 */
import type { BlockContent } from '@lib/sanity/sanity.types'
import RichText from '@components/rich-text/RichText.astro'
import Icon from '@components/ui/Icon.astro'

import Section, { type Tone } from './Section.astro'

interface FaqItem {
  _key?: string
  question?: string
  answer?: BlockContent
}

interface FaqGroup {
  _key?: string
  heading?: string
  items?: readonly FaqItem[]
}

interface Props {
  id?: string
  eyebrow?: string
  heading?: string
  intro?: string
  groups: readonly FaqGroup[]
  tone?: Tone
}

const { id = 'faq', eyebrow, heading, intro, groups, tone } = Astro.props

const GroupHeading = heading ? 'h3' : 'h2'
---

<Section id={id} eyebrow={eyebrow} heading={heading} intro={intro} tone={tone} width="narrow">
  <div class="space-y-12">
    {
      groups.map((group) => (
        <div>
          {group.heading && (
            <GroupHeading class="text-heading mb-4 font-serif text-2xl md:text-3xl">
              {group.heading}
            </GroupHeading>
          )}
          <div class="divide-border border-border bg-surface shadow-soft divide-y rounded-sm border">
            {(group.items ?? []).map((item) => (
              <details class="group px-5 py-4 md:px-6 md:py-5">
                <summary class="text-heading flex cursor-pointer list-none items-center justify-between gap-4 rounded-sm font-medium [&::-webkit-details-marker]:hidden">
                  {item.question}
                  <Icon
                    name="chevron-down"
                    class="text-brand-dark size-5 shrink-0 transition-transform group-open:rotate-180 motion-reduce:transition-none"
                  />
                </summary>
                {item.answer && <RichText value={item.answer} class="mt-3" />}
              </details>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</Section>
