---
import { CONSENT_BANNER_ID } from '@lib/analytics/config'
import { siteConfig } from '@lib/config/site'
import { contactDetails, getSiteSettings } from '@lib/sanity/settings'
import Icon from '@components/ui/Icon.astro'

const { footer } = siteConfig
const settings = await getSiteSettings()
const { contact, navigation: nav } = settings
const contactItems = contactDetails(contact, footer.labels)

const HEADING = 'font-display text-needle mb-4 text-2xl font-extrabold'
const LINK = 'hover:text-needle rounded-sm underline-offset-4 transition-colors hover:underline'
---

<footer class="bg-espresso text-mist text-sm leading-relaxed">
  <div class="container-wide grid gap-10 py-12 sm:grid-cols-2 md:py-16 lg:grid-cols-12 lg:gap-8">
    <div class="lg:col-span-4">
      <a href="/" class="text-surface font-display rounded-sm text-4xl leading-none font-black">
        {settings.siteName}
      </a>
      <p class="mt-4 max-w-xs">{settings.description}</p>
      <p
        class="border-needle text-needle font-display mt-6 inline-flex -rotate-2 rounded-md border-2 px-3 py-1.5 text-lg font-bold"
      >
        {settings.demoLabel}
      </p>
    </div>

    <nav aria-label="Footer" class="lg:col-span-2">
      <h2 class={HEADING}>{footer.headings.nav}</h2>
      <ul class="grid grid-cols-2 gap-x-6 gap-y-2 lg:grid-cols-1">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class={LINK}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="lg:col-span-3">
      <h2 class={HEADING}>{footer.headings.contact}</h2>
      <dl class="space-y-3">
        {
          contactItems.map((item) => (
            <div>
              <dt class="text-surface flex items-center gap-2 font-bold">
                <Icon name={item.icon} class="text-needle size-4 shrink-0" />
                {item.label}
              </dt>
              <dd class="mt-0.5 pl-6">
                <a href={item.href} class:list={[LINK, 'text-surface break-words']}>
                  {item.value}
                </a>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="lg:col-span-3">
      <h2 class={HEADING}>{footer.headings.hours}</h2>
      <ul class="space-y-1.5">
        {
          contact.hours.map((line) => (
            <li class="flex gap-2">
              <Icon name="clock" class="text-needle mt-1 size-4 shrink-0" />
              {line}
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="border-mist/15 border-t">
    <div class="container-wide flex flex-wrap items-center gap-x-6 gap-y-3 py-6">
      <p>{footer.copyright}</p>
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        <li>
          <a href={footer.legal.privacy.href} class={LINK}>{footer.legal.privacy.label}</a>
        </li>
        <li data-consent-settings hidden>
          <button
            type="button"
            popovertarget={CONSENT_BANNER_ID}
            class:list={[LINK, 'cursor-pointer']}
          >
            {footer.legal.cookieSettings}
          </button>
        </li>
      </ul>
    </div>
  </div>
</footer>
