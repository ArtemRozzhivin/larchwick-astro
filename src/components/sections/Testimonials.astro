---
import Section from './Section.astro'

interface Testimonial {
  quote: string
  author: string
  role?: string
  avatar?: string
}

interface Props {
  id?: string
  eyebrow?: string
  title?: string
  subtitle?: string
  items: readonly Testimonial[]
}

const { id = 'testimonials', eyebrow, title, subtitle, items } = Astro.props
---

<Section id={id} eyebrow={eyebrow} title={title} subtitle={subtitle}>
  <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      items.map((item) => (
        <li class="shadow-soft flex flex-col rounded-2xl border border-gray-200 bg-white p-6">
          <blockquote class="flex-1 text-gray-700">
            <p>“{item.quote}”</p>
          </blockquote>
          <figcaption class="mt-6 flex items-center gap-3">
            {item.avatar && (
              <img
                src={item.avatar}
                alt=""
                width="40"
                height="40"
                loading="lazy"
                decoding="async"
                class="size-10 rounded-full object-cover"
              />
            )}
            <span>
              <span class="block font-medium text-gray-900">{item.author}</span>
              {item.role && <span class="block text-sm text-gray-500">{item.role}</span>}
            </span>
          </figcaption>
        </li>
      ))
    }
  </ul>
</Section>
