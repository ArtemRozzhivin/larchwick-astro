---
import { ui } from '@lib/content/ui'
import type { CardGrid as CardGridValue } from '@lib/sanity/sanity.types'
import { isUsableLink, type Link } from '@lib/types'
import { buttonVariants } from '@components/ui/button'
import Icon from '@components/ui/Icon.astro'
import SanityImage from '@components/ui/SanityImage.astro'
import SpecList from '@components/ui/SpecList.astro'

import { itemHeading } from './heading'
import Section, { type LightTone } from './Section.astro'

type Card = Pick<
  NonNullable<CardGridValue['cards']>[number],
  'roast' | 'image' | 'eyebrow' | 'title' | 'text' | 'specs' | 'points' | 'price' | 'cta'
>

interface Props {
  id?: string
  eyebrow?: string
  heading?: string
  intro?: string
  cards: readonly Card[]
  layout?: 'cards' | 'bags'
  cta?: Link
  tone?: LightTone
}

const { id, eyebrow, heading, intro, cards, layout = 'cards', cta, tone } = Astro.props

const GRID_CLASSES: Record<number, string> = {
  1: 'mx-auto max-w-xl',
  2: 'md:grid-cols-2',
  4: 'sm:grid-cols-2 lg:grid-cols-4',
}
const gridClass = GRID_CLASSES[cards.length] ?? 'md:grid-cols-2 lg:grid-cols-3'
const CardHeading = itemHeading(heading)
const BAG_TONES: Record<NonNullable<Card['roast']>, string> = {
  light: 'bg-roast-light text-espresso',
  medium: 'bg-roast-medium text-espresso',
  dark: 'bg-roast-dark text-surface',
  seasonal: 'bg-larch text-surface',
}
const isBags = layout === 'bags'
---

<Section id={id} eyebrow={eyebrow} heading={heading} intro={intro} tone={tone}>
  {
    isBags ? (
      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {cards.map((card, index) => (
          <li
            class:list={[
              'reveal rounded-b-photo flex flex-col rounded-t-md px-6 pb-6',
              BAG_TONES[card.roast ?? 'medium'],
            ]}
            style={`--reveal-delay: ${index}`}
          >
            <span class="bag-crimp -mx-6 mb-6 block h-[18px] rounded-t-md" aria-hidden="true" />
            <CardHeading class="font-display text-[2rem] leading-[0.95] font-black">
              {card.title}
            </CardHeading>
            {card.text && <p class="mt-3 mb-6 leading-relaxed text-pretty">{card.text}</p>}
            <p class="mt-auto flex justify-between gap-4 border-t-2 border-current pt-3 font-bold">
              <span>{ui.roastLabels[card.roast ?? 'medium']}</span>
              {card.price && <span>{card.price}</span>}
            </p>
            {isUsableLink(card.cta) && (
              <a href={card.cta.href} class="mt-3 font-bold underline underline-offset-4">
                {card.cta.label}
              </a>
            )}
          </li>
        ))}
      </ul>
    ) : (
      <ul class:list={['grid gap-8', gridClass]}>
        {cards.map((card, index) => (
          <li
            class="reveal bg-surface text-ink border-espresso shadow-label rounded-label flex flex-col overflow-hidden border-2"
            style={`--reveal-delay: ${index}`}
          >
            {card.image && (
              <SanityImage
                image={card.image}
                widths={[400, 640, 800]}
                sizes="(min-width: 64rem) 24rem, (min-width: 48rem) 50vw, 100vw"
                aspectRatio={4 / 3}
                class="border-espresso w-full border-b-2"
              />
            )}
            <div class="flex flex-1 flex-col p-6">
              {card.eyebrow && <p class="text-larch mb-2 font-bold">{card.eyebrow}</p>}
              <CardHeading class="font-display text-espresso text-[2rem] leading-[0.95] font-black">
                {card.title}
              </CardHeading>
              {card.text && <p class="mt-3 leading-relaxed text-pretty">{card.text}</p>}
              {card.specs && card.specs.length > 0 && (
                <SpecList items={card.specs} size="sm" class="mt-5" />
              )}
              {card.points && card.points.length > 0 && (
                <ul class="mt-5 space-y-2">
                  {card.points.map((point) => (
                    <li class="flex gap-2">
                      <Icon name="check" class="text-larch mt-1 size-4 shrink-0" />
                      {point}
                    </li>
                  ))}
                </ul>
              )}
              {card.price && <p class="text-espresso mt-5 font-bold">{card.price}</p>}
              {isUsableLink(card.cta) && (
                <div class="mt-auto pt-6">
                  <a
                    href={card.cta.href}
                    class={buttonVariants({ variant: 'secondary', size: 'sm' })}
                  >
                    {card.cta.label}
                  </a>
                </div>
              )}
            </div>
          </li>
        ))}
      </ul>
    )
  }
  {
    isUsableLink(cta) && (
      <div class="reveal mt-10">
        <a href={cta.href} class={buttonVariants({ variant: 'primary' })}>
          {cta.label}
        </a>
      </div>
    )
  }
</Section>
