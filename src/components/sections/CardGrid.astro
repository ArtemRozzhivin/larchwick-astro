---
import type { SanityImageValue } from '@lib/sanity/image'
import { buttonVariants } from '@components/ui/button'
import Icon from '@components/ui/Icon.astro'
import SanityImage from '@components/ui/SanityImage.astro'

import Section, { type Tone } from './Section.astro'

interface Link {
  label?: string
  href?: string
}

interface Card {
  _key?: string
  image?: SanityImageValue
  eyebrow?: string
  title?: string
  text?: string
  specs?: readonly { _key?: string; label?: string; value?: string }[]
  points?: readonly string[]
  price?: string
  cta?: Link
}

interface Props {
  id?: string
  eyebrow?: string
  heading?: string
  intro?: string
  cards: readonly Card[]
  cta?: Link
  tone?: Tone
}

const { id, eyebrow, heading, intro, cards, cta, tone } = Astro.props

const GRID_CLASSES: Record<number, string> = {
  1: 'mx-auto max-w-xl',
  2: 'md:grid-cols-2',
  4: 'sm:grid-cols-2 lg:grid-cols-4',
}
const gridClass = GRID_CLASSES[cards.length] ?? 'md:grid-cols-2 lg:grid-cols-3'
const CardHeading = heading ? 'h3' : 'h2'
---

<Section id={id} eyebrow={eyebrow} heading={heading} intro={intro} tone={tone}>
  <ul class:list={['grid gap-6', gridClass]}>
    {
      cards.map((card) => (
        <li class="bg-surface text-body shadow-soft flex flex-col overflow-hidden rounded-sm border">
          {card.image && (
            <SanityImage
              image={card.image}
              widths={[400, 640, 800]}
              sizes="(min-width: 64rem) 24rem, (min-width: 48rem) 50vw, 100vw"
              aspectRatio={4 / 3}
              class="w-full"
            />
          )}
          <div class="flex flex-1 flex-col p-6">
            {card.eyebrow && (
              <p class="text-brand-dark mb-2 text-sm font-semibold tracking-widest uppercase">
                {card.eyebrow}
              </p>
            )}
            <CardHeading class="text-heading font-serif text-2xl leading-snug">
              {card.title}
            </CardHeading>
            {card.text && <p class="mt-3 leading-relaxed text-pretty">{card.text}</p>}
            {card.specs && card.specs.length > 0 && (
              <dl class="mt-5 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1.5 text-sm">
                {card.specs.map((spec) => (
                  <>
                    <dt class="text-heading font-semibold">{spec.label}</dt>
                    <dd>{spec.value}</dd>
                  </>
                ))}
              </dl>
            )}
            {card.points && card.points.length > 0 && (
              <ul class="mt-5 space-y-2 text-sm">
                {card.points.map((point) => (
                  <li class="flex gap-2">
                    <Icon name="check" class="text-brand-dark mt-0.5 size-4 shrink-0" />
                    {point}
                  </li>
                ))}
              </ul>
            )}
            {card.price && <p class="text-heading mt-5 font-semibold">{card.price}</p>}
            {card.cta?.href && card.cta.label && (
              <a
                href={card.cta.href}
                class:list={[
                  'mt-auto self-start pt-6',
                  'text-brand-dark hover:text-heading font-medium underline underline-offset-4',
                ]}
              >
                {card.cta.label}
              </a>
            )}
          </div>
        </li>
      ))
    }
  </ul>
  {
    cta?.href && cta.label && (
      <div class="mt-10 text-center">
        <a href={cta.href} class={buttonVariants({ variant: 'primary' })}>
          {cta.label}
        </a>
      </div>
    )
  }
</Section>
