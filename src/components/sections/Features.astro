---
import type { IconName } from '@lib/types'
import Icon from '@components/ui/Icon.astro'

import Section from './Section.astro'

interface Feature {
  icon?: IconName
  title: string
  description: string
}

interface Props {
  id?: string
  eyebrow?: string
  title?: string
  subtitle?: string
  items: readonly Feature[]
  columns?: 2 | 3
}

const { id = 'features', eyebrow, title, subtitle, items, columns = 3 } = Astro.props

const GRID_CLASSES = {
  2: 'sm:grid-cols-2',
  3: 'md:grid-cols-3',
} as const

const ItemHeading = title ? 'h3' : 'h2'
---

<Section id={id} eyebrow={eyebrow} title={title} subtitle={subtitle}>
  <ul class:list={['grid gap-x-8 gap-y-10 text-center', GRID_CLASSES[columns]]}>
    {
      items.map((item) => (
        <li class="mx-auto max-w-sm">
          {item.icon && (
            <span class="text-brand-dark mb-4 inline-flex">
              <Icon name={item.icon} class="size-9" />
            </span>
          )}
          <ItemHeading class="text-heading font-serif text-2xl leading-snug">
            {item.title}
          </ItemHeading>
          <p class="mt-2 leading-relaxed text-pretty">{item.description}</p>
        </li>
      ))
    }
  </ul>
</Section>
