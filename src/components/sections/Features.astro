---
import { isIconName } from '@lib/types'
import Icon from '@components/ui/Icon.astro'

import Section, { type Tone } from './Section.astro'

interface Feature {
  _key?: string
  icon?: string
  title?: string
  text?: string
}

interface Props {
  id?: string
  eyebrow?: string
  heading?: string
  intro?: string
  items: readonly Feature[]
  tone?: Tone
}

const { id = 'features', eyebrow, heading, intro, items, tone } = Astro.props

const GRID_CLASSES: Record<number, string> = {
  2: 'sm:grid-cols-2',
  4: 'sm:grid-cols-2 lg:grid-cols-4',
}
const gridClass = GRID_CLASSES[items.length] ?? 'md:grid-cols-3'
const ItemHeading = heading ? 'h3' : 'h2'
---

<Section id={id} eyebrow={eyebrow} heading={heading} intro={intro} tone={tone}>
  <ul class:list={['grid gap-x-8 gap-y-10 text-center', gridClass]}>
    {
      items.map((item) => (
        <li class="mx-auto max-w-sm">
          {isIconName(item.icon) && (
            <span class="text-brand-dark mb-4 inline-flex">
              <Icon name={item.icon} class="size-9" />
            </span>
          )}
          <ItemHeading class="text-heading font-serif text-2xl leading-snug">
            {item.title}
          </ItemHeading>
          {item.text && <p class="mt-2 leading-relaxed text-pretty">{item.text}</p>}
        </li>
      ))
    }
  </ul>
</Section>
