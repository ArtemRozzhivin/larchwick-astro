---
import type { FeatureGrid } from '@lib/sanity/sanity.types'
import { isIconName } from '@lib/types'
import Icon from '@components/ui/Icon.astro'

import { itemHeading } from './heading'
import Section, { type LightTone } from './Section.astro'

type Feature = Pick<NonNullable<FeatureGrid['items']>[number], 'icon' | 'title' | 'text'>

interface Props {
  id?: string
  eyebrow?: string
  heading?: string
  intro?: string
  items: readonly Feature[]
  tone?: LightTone
}

const { id, eyebrow, heading, intro, items, tone } = Astro.props

const GRID_CLASSES: Record<number, string> = {
  2: 'sm:grid-cols-2',
  4: 'sm:grid-cols-2 lg:grid-cols-4',
}
const gridClass = GRID_CLASSES[items.length] ?? 'md:grid-cols-3'
const ItemHeading = itemHeading(heading)
---

<Section id={id} eyebrow={eyebrow} heading={heading} intro={intro} tone={tone}>
  <ul class:list={['grid gap-x-8 gap-y-10', gridClass]}>
    {
      items.map((item, index) => (
        <li class="reveal border-needle border-l-6 pl-5" style={`--reveal-delay: ${index}`}>
          {isIconName(item.icon) && (
            <span class="text-larch mb-3 inline-flex">
              <Icon name={item.icon} class="size-8" />
            </span>
          )}
          <ItemHeading class="font-display text-[1.9rem] leading-none font-extrabold">
            {item.title}
          </ItemHeading>
          {item.text && <p class="mt-2 leading-relaxed text-pretty">{item.text}</p>}
        </li>
      ))
    }
  </ul>
</Section>
