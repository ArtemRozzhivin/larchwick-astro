---
/**
 * Layout primitive every section is built on.
 *
 * Owns the container width, vertical rhythm, and the optional eyebrow/title/
 * subtitle header, so sections stay consistent without repeating the markup.
 */
interface Props {
  id?: string
  eyebrow?: string
  title?: string
  subtitle?: string
  align?: 'left' | 'center'
  tone?: 'default' | 'muted' | 'inverted'
  class?: string
}

const {
  id,
  eyebrow,
  title,
  subtitle,
  align = 'center',
  tone = 'default',
  class: className = '',
} = Astro.props

const TONE_CLASSES: Record<NonNullable<Props['tone']>, string> = {
  default: 'bg-surface text-body',
  muted: 'bg-canvas text-body',
  inverted: 'bg-dark text-subtle',
}

const hasHeader = Boolean(eyebrow || title || subtitle)
const isCentered = align === 'center'
const isInverted = tone === 'inverted'
---

<section id={id} class:list={['py-12 md:py-20', TONE_CLASSES[tone], className]}>
  <div class="container-wide">
    {
      hasHeader && (
        <header class:list={['mb-10 md:mb-12', isCentered && 'mx-auto max-w-2xl text-center']}>
          {eyebrow && (
            <p
              class:list={[
                'mb-3 text-sm font-semibold tracking-widest text-balance uppercase',
                isInverted ? 'text-brand' : 'text-brand-dark',
              ]}
            >
              {eyebrow}
            </p>
          )}
          {title && (
            <h2
              class:list={[
                'font-serif text-3xl leading-tight text-balance md:text-4xl',
                isInverted ? 'text-surface' : 'text-heading',
              ]}
            >
              {title}
            </h2>
          )}
          {subtitle && <p class="mt-4 text-lg leading-relaxed text-pretty">{subtitle}</p>}
        </header>
      )
    }
    <slot />
  </div>
</section>
