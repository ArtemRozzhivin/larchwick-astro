---
/**
 * Layout primitive every section is built on.
 *
 * Owns the container width, vertical rhythm, and the optional eyebrow/heading/
 * intro header, so sections stay consistent without repeating the markup.
 */
export type Tone = 'default' | 'muted' | 'inverted'

interface Props {
  id?: string
  eyebrow?: string
  heading?: string
  intro?: string
  align?: 'left' | 'center'
  width?: 'wide' | 'narrow'
  tone?: Tone
  class?: string
}

const {
  id,
  eyebrow,
  heading,
  intro,
  align = 'center',
  width = 'wide',
  tone = 'default',
  class: className = '',
} = Astro.props

const TONE_CLASSES: Record<Tone, string> = {
  default: 'bg-surface text-body',
  muted: 'bg-canvas text-body',
  inverted: 'bg-dark text-subtle',
}

const hasHeader = Boolean(eyebrow || heading || intro)
const isCentered = align === 'center'
const isInverted = tone === 'inverted'
---

<section id={id} class:list={['py-12 md:py-20', TONE_CLASSES[tone], className]}>
  <div class:list={['container-wide', width === 'narrow' && 'max-w-3xl']}>
    {
      hasHeader && (
        <header class:list={['mb-10 md:mb-12', isCentered && 'mx-auto max-w-2xl text-center']}>
          {eyebrow && (
            <p
              class:list={[
                'mb-3 text-sm font-semibold tracking-widest text-balance uppercase',
                isInverted ? 'text-brand' : 'text-brand-dark',
              ]}
            >
              {eyebrow}
            </p>
          )}
          {heading && (
            <h2
              class:list={[
                'font-serif text-3xl leading-tight text-balance md:text-4xl',
                isInverted ? 'text-surface' : 'text-heading',
              ]}
            >
              {heading}
            </h2>
          )}
          {intro && <p class="mt-4 text-lg leading-relaxed text-pretty">{intro}</p>}
        </header>
      )
    }
    <slot />
  </div>
</section>
