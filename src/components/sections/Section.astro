---
/**
 * Layout primitive every section is built on.
 *
 * Owns the page width, vertical rhythm, and the optional eyebrow/heading/
 * intro header, so sections stay consistent without repeating the markup.
 */
import SectionHeader from './SectionHeader.astro'

export type Tone = 'default' | 'muted' | 'inverted'
/** The tones of sections whose own text is dark: everything but the larch band. */
export type LightTone = Exclude<Tone, 'inverted'>

interface Props {
  id?: string
  eyebrow?: string
  heading?: string
  intro?: string
  align?: 'left' | 'center'
  width?: 'wide' | 'narrow'
  tone?: Tone
  class?: string
}

const {
  id,
  eyebrow,
  heading,
  intro,
  align = 'left',
  width = 'wide',
  tone = 'default',
  class: className = '',
} = Astro.props

const TONE_CLASSES: Record<Tone, string> = {
  default: 'bg-paper text-ink',
  muted: 'bg-surface text-ink border-y-2 border-espresso',
  inverted: 'bg-larch text-mist',
}
---

<section id={id} class:list={['py-8 md:py-12', TONE_CLASSES[tone], className]}>
  <div class:list={['container-wide', width === 'narrow' && 'max-w-3xl']}>
    <SectionHeader
      eyebrow={eyebrow}
      heading={heading}
      intro={intro}
      align={align}
      tone={tone}
      class="mb-8 max-w-2xl md:mb-10"
    />
    <slot />
  </div>
</section>
