---
import { notFound } from '@lib/content/not-found'
import Section from '@components/sections/Section.astro'
import { buttonVariants } from '@components/ui/button'
import Layout from '@layouts/Layout.astro'

const { seo, code, title, message, primaryCta, secondaryCtas } = notFound
---

<Layout {...seo} noindex>
  <Section class="flex flex-1 flex-col justify-center">
    <div class="mx-auto max-w-xl py-4 text-center md:py-8" data-track-view="page_not_found">
      <p
        aria-hidden="true"
        class="border-stamp text-stamp font-display mx-auto grid size-40 rotate-[-12deg] place-items-center rounded-full border-4 text-7xl leading-none font-black motion-safe:animate-[press_0.55s_cubic-bezier(0.2,1.4,0.4,1)_0.3s_both]"
      >
        {code}
      </p>
      <h1 class="text-espresso font-display mt-8 text-5xl leading-[0.95] font-black md:text-7xl">
        {title}
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-pretty">{message}</p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:justify-center">
        <a href={primaryCta.href} class={buttonVariants({ variant: 'primary' })}>
          {primaryCta.label}
        </a>
        {
          secondaryCtas.map((cta) => (
            <a href={cta.href} class={buttonVariants({ variant: 'secondary' })}>
              {cta.label}
            </a>
          ))
        }
      </div>
    </div>
  </Section>
</Layout>
