---
import { notFound } from '@lib/content/not-found'
import Section from '@components/sections/Section.astro'
import { buttonVariants } from '@components/ui/button'
import Layout from '@layouts/Layout.astro'

const { seo, code, title, message, primaryCta, secondaryCtas } = notFound
---

<Layout {...seo} noindex>
  <Section class="flex flex-1 flex-col justify-center">
    <div class="mx-auto max-w-xl py-4 text-center md:py-8">
      <p aria-hidden="true" class="text-brand font-serif text-8xl leading-none md:text-9xl">
        {code}
      </p>
      <h1 class="text-heading mt-6 font-serif text-4xl leading-tight md:text-5xl">{title}</h1>
      <p class="mt-4 text-lg leading-relaxed text-pretty">{message}</p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:justify-center">
        <a href={primaryCta.href} class={buttonVariants({ variant: 'primary' })}>
          {primaryCta.label}
        </a>
        {
          secondaryCtas.map((cta) => (
            <a href={cta.href} class={buttonVariants({ variant: 'secondary' })}>
              {cta.label}
            </a>
          ))
        }
      </div>
    </div>
  </Section>
</Layout>
