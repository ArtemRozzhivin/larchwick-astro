---
import { buttonVariants } from '@components/ui/button'
import Layout from '@layouts/Layout.astro'
---

<Layout title="404 — Page Not Found" noIndex={true} showHeader={false} showFooter={false}>
  <div class="relative flex min-h-screen flex-col items-center justify-center overflow-hidden px-6">
    <!-- Dot grid background -->
    <div
      class="pointer-events-none absolute inset-0 [background-image:radial-gradient(circle,var(--color-gray-300)_1.5px,transparent_1.5px)] [background-size:28px_28px] opacity-60"
    >
    </div>

    <!-- Radial fade to white from center -->
    <div
      class="pointer-events-none absolute inset-0 [background:radial-gradient(ellipse_70%_70%_at_50%_50%,transparent_30%,white_100%)]"
    >
    </div>

    <!-- Content -->
    <div class="relative z-10 flex flex-col items-center text-center">
      <!-- 404 stacked text -->
      <div class="relative mb-6 leading-none select-none">
        <!-- Offset shadow layer -->
        <span
          aria-hidden="true"
          class="animate-slide-up text-primary-200 absolute top-3 left-3 text-[9rem] font-black tracking-tighter md:text-[15rem]"
        >
          404
        </span>
        <!-- Main layer -->
        <span
          class="animate-slide-up relative text-[9rem] font-black tracking-tighter text-gray-900 md:text-[15rem]"
        >
          404
        </span>
      </div>

      <!-- Divider -->
      <div class="h-px w-16 bg-gray-300"></div>

      <h1
        class="animate-slide-up mt-8 text-2xl font-semibold tracking-tight text-gray-900 md:text-3xl"
      >
        Page not found
      </h1>
      <p class="animate-slide-up mt-3 max-w-xs text-base text-gray-500">
        The page you're looking for doesn't exist or has been moved.
      </p>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
        <a href="/" class={buttonVariants({ variant: 'primary', size: 'default', rounded: 'lg' })}>
          Go home
        </a>
        <a
          href="/contact/"
          class={buttonVariants({ variant: 'outline', size: 'default', rounded: 'lg' })}
        >
          Contact us
        </a>
      </div>
    </div>
  </div>
</Layout>
