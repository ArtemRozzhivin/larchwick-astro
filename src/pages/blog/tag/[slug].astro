---
import { archivePaths, type TermArchive } from '@lib/sanity/archives'
import BlogArchive from '@components/blog/BlogArchive.astro'
import Layout from '@layouts/Layout.astro'

type Props = TermArchive

export const getStaticPaths = () => archivePaths('tag')

const { seo, archive } = Astro.props
---

<Layout {...seo}>
  <BlogArchive {...archive} />
</Layout>
