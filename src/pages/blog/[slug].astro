---
import { siteConfig } from '@lib/config/site'
import { blog } from '@lib/content/blog'
import { BLOG_PATH, postPath } from '@lib/routes'
import { adjacentPosts, getPosts, type Post, relatedPosts } from '@lib/sanity/posts'
import { getSiteSettings } from '@lib/sanity/settings'
import { canonicalUrl } from '@lib/seo/canonical'
import { layoutSeo } from '@lib/seo/layout-seo'
import { blogPostingSchema, breadcrumbListSchema } from '@lib/seo/schema'
import PostGrid from '@components/blog/PostGrid.astro'
import PostHeader from '@components/blog/PostHeader.astro'
import PostNav from '@components/blog/PostNav.astro'
import PostTags from '@components/blog/PostTags.astro'
import RichText from '@components/rich-text/RichText.astro'
import Section from '@components/sections/Section.astro'
import Layout from '@layouts/Layout.astro'

interface Props {
  post: Post
  related: Post[]
  newer?: Post
  older?: Post
}

export async function getStaticPaths() {
  const posts = await getPosts()
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post, related: relatedPosts(post, posts), ...adjacentPosts(post, posts) },
  }))
}

const { post, related, newer, older } = Astro.props

const seo = layoutSeo(post.seo, {
  title: `${post.title} | ${siteConfig.name}`,
  description: post.excerpt ?? undefined,
  image: post.mainImage,
})
const settings = await getSiteSettings()
const path = postPath(post)
const jsonLd = [
  blogPostingSchema({
    title: post.title ?? '',
    description: seo.description ?? settings.description,
    url: canonicalUrl(seo.canonical ?? path, siteConfig.url),
    publishedAt: post.publishedAt ?? post._updatedAt,
    modifiedAt: post._updatedAt,
    image: seo.ogImage?.src,
  }),
  breadcrumbListSchema([
    { name: blog.breadcrumbs.home, path: '/' },
    { name: blog.breadcrumbs.blog, path: BLOG_PATH },
    { name: post.title ?? '', path },
  ]),
]
---

<Layout
  {...seo}
  ogType="article"
  publishedTime={post.publishedAt ?? undefined}
  modifiedTime={post._updatedAt}
  jsonLd={jsonLd}
>
  <article>
    <PostHeader post={post} />

    <div class="container-wide max-w-3xl pt-16 pb-12">
      <RichText value={post.body ?? []} class="text-lg" />
      <PostTags tags={post.tags} />
    </div>
  </article>

  <PostNav newer={newer} older={older} />

  {
    related.length > 0 && (
      <Section heading={blog.relatedHeading} tone="muted">
        <PostGrid posts={related} headingLevel="h3" />
      </Section>
    )
  }
</Layout>
