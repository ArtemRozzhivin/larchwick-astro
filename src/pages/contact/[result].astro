---
import { contactResult } from '@lib/content/contact'
import { CONTACT_RESULTS, type ContactResult } from '@lib/routes'
import CTA from '@components/sections/CTA.astro'
import Section from '@components/sections/Section.astro'
import Layout from '@layouts/Layout.astro'

interface Props {
  result: ContactResult
}

export function getStaticPaths() {
  return CONTACT_RESULTS.map((result) => ({ params: { result }, props: { result } }))
}

const { result } = Astro.props
const { seo, heading, message, primaryCta, secondaryCta } = contactResult[result]

const TRACKING: Partial<Record<ContactResult, Record<`data-${string}`, string>>> = {
  thanks: { 'data-track-view': 'generate_lead', 'data-track-form-name': 'contact' },
}
const tracking = TRACKING[result]
---

<Layout {...seo} noindex>
  <Section>
    {/* From md, as wide as the message in the CTA below */}
    <div class="mx-auto py-12 text-center md:max-w-xl md:py-16" {...tracking}>
      <h1
        class="text-espresso font-display text-4xl leading-tight font-extrabold text-balance sm:text-5xl"
      >
        {heading}
      </h1>
    </div>
  </Section>
  <CTA text={message} primaryCta={primaryCta} secondaryCta={secondaryCta} tone="default" />
</Layout>
