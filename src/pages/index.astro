---
import { siteConfig } from '@lib/config/site'
import { sanityFetch } from '@lib/sanity/client'
import { imageSource } from '@lib/sanity/image'
import { PAGE_QUERY } from '@lib/sanity/queries'
import type { PAGE_QUERY_RESULT } from '@lib/sanity/sanity.types'
import { getSiteSettings } from '@lib/sanity/settings'
import { organizationSchema, websiteSchema } from '@lib/seo/schema'
import SectionRenderer from '@components/sections/SectionRenderer.astro'
import Layout from '@layouts/Layout.astro'

const [page, settings] = await Promise.all([
  sanityFetch<PAGE_QUERY_RESULT>(PAGE_QUERY, { slug: 'home' }),
  getSiteSettings(),
])
if (!page) throw new Error('Sanity has no page with slug "home"')

const seo = page.seo
const ogImage = seo?.ogImage?.asset ? imageSource(seo.ogImage, 1200, 1200 / 630).src : undefined
const jsonLd = [organizationSchema(settings), websiteSchema(settings)]
---

<Layout
  title={seo?.metaTitle ?? siteConfig.title}
  description={seo?.metaDescription ?? undefined}
  ogImage={ogImage}
  jsonLd={jsonLd}
>
  <SectionRenderer sections={page.sections ?? []} />
</Layout>
