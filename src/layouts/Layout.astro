---
import '../styles/global.css'

import { Font } from 'astro:assets'

import { siteConfig } from '@lib/config/site'
import type { JsonLd } from '@lib/seo/schema'
import Footer from '@components/sections/Footer.astro'
import Header from '@components/sections/Header.astro'

interface Props {
  /** The exact <title>; nothing is appended. */
  title?: string
  description?: string
  /** A path or an absolute URL; defaults to the current path. */
  canonical?: string
  /** A 1200×630 image, as a path or an absolute URL. */
  ogImage?: string
  ogImageAlt?: string
  ogType?: 'website' | 'article'
  /** ISO 8601; rendered only when ogType is 'article'. */
  publishedTime?: string
  modifiedTime?: string
  noindex?: boolean
  jsonLd?: JsonLd | readonly JsonLd[]
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  canonical = Astro.url.pathname,
  ogImage = siteConfig.ogImage,
  ogImageAlt = siteConfig.ogImageAlt,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  noindex = false,
  jsonLd = [],
} = Astro.props

const ROBOTS_INDEX = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'
const ROBOTS_NOINDEX = 'noindex, follow'
const OG_IMAGE_WIDTH = 1200
const OG_IMAGE_HEIGHT = 630

const pageUrl = new URL(canonical, siteConfig.url)
pageUrl.pathname = pageUrl.pathname.replace(/\/?$/, '/')
const canonicalHref = noindex ? undefined : pageUrl.href
const robots = noindex ? ROBOTS_NOINDEX : ROBOTS_INDEX
const ogImageHref = new URL(ogImage, siteConfig.url).href
const isArticle = ogType === 'article'
const jsonLdBlocks = (Array.isArray(jsonLd) ? jsonLd : [jsonLd]).map((node) =>
  JSON.stringify(node).replace(/</g, '\\u003c'),
)
---

<!doctype html>
<html lang={siteConfig.lang} class="motion-safe:scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {canonicalHref && <link rel="canonical" href={canonicalHref} />}

    <Font cssVariable="--font-dm-serif-display" preload />
    <Font cssVariable="--font-inter" preload={[{ style: 'normal' }]} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content={siteConfig.themeColor} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:locale" content={siteConfig.locale} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalHref && <meta property="og:url" content={canonicalHref} />}
    <meta property="og:image" content={ogImageHref} />
    <meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
    <meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {
      isArticle && publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
      )
    }
    {isArticle && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLdBlocks.map((block) => <script type="application/ld+json" is:inline set:html={block} />)}

    <slot name="head" />
  </head>

  <body class="bg-surface text-body flex min-h-dvh flex-col font-sans antialiased">
    <a
      href="#main"
      class="bg-brand-dark outline-brand-dark sr-only z-50 rounded-sm font-medium text-white focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:px-4 focus:py-2"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" tabindex="-1" class="flex flex-1 flex-col outline-none">
      <slot />
    </main>
    <Footer />
  </body>
</html>
