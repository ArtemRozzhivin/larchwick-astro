---
import '../styles/global.css'

import { siteConfig } from '@lib/config/site'
import Footer from '@components/sections/Footer.astro'
import Header from '@components/sections/Header.astro'

interface Props {
  title?: string
  description?: string
  ogImage?: string
  noIndex?: boolean
  /** Set false for pages that own their own chrome (e.g. a bare 404). */
  showHeader?: boolean
  showFooter?: boolean
  headerCta?: { label: string; href: string }
}

const {
  title,
  description = siteConfig.description,
  ogImage = siteConfig.ogImage,
  noIndex = false,
  showHeader = true,
  showFooter = true,
  headerCta,
} = Astro.props

const pageTitle = title ? `${title} | ${siteConfig.name}` : siteConfig.name
const canonicalURL = new URL(Astro.url.pathname, siteConfig.url)
const ogImageURL = new URL(ogImage, siteConfig.url)

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteConfig.name,
  url: siteConfig.url,
  description: siteConfig.description,
  logo: ogImageURL.href,
}
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content={siteConfig.name} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

    <slot name="head" />
  </head>

  <body class="mx-auto min-h-screen max-w-screen-2xl bg-white text-black">
    {showHeader && <Header cta={headerCta} />}
    <main>
      <slot />
    </main>
    {showFooter && <Footer />}
  </body>
</html>
