---
import '../styles/global.css'

import { Font } from 'astro:assets'

import { MAIN_ID } from '@lib/analytics/config'
import { siteConfig } from '@lib/config/site'
import { OG_IMAGE_HEIGHT, OG_IMAGE_WIDTH, type SocialImage } from '@lib/sanity/image'
import { getSiteSettings } from '@lib/sanity/settings'
import { canonicalUrl } from '@lib/seo/canonical'
import type { JsonLd } from '@lib/seo/schema'
import ChatPanel from '@components/chat/ChatPanel.astro'
import ConsentBanner from '@components/consent/ConsentBanner.astro'
import Footer from '@components/sections/Footer.astro'
import Header from '@components/sections/Header.astro'

interface Props {
  /** The exact <title>; nothing is appended. */
  title?: string
  description?: string
  /** A path or an absolute URL; defaults to the current path. */
  canonical?: string
  /** `src` is a path or an absolute URL; without `alt`, no og:image:alt. Defaults to the site's image. */
  ogImage?: SocialImage
  ogType?: 'website' | 'article'
  /** ISO 8601; rendered only when ogType is 'article'. */
  publishedTime?: string
  modifiedTime?: string
  noindex?: boolean
  jsonLd?: JsonLd | readonly JsonLd[]
}

const DEFAULT_OG_IMAGE: SocialImage = {
  src: siteConfig.ogImage,
  width: OG_IMAGE_WIDTH,
  height: OG_IMAGE_HEIGHT,
  alt: siteConfig.ogImageAlt,
}

const {
  title = siteConfig.title,
  description,
  canonical = Astro.url.pathname,
  ogImage = DEFAULT_OG_IMAGE,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  noindex = false,
  jsonLd = [],
} = Astro.props

const settings = await getSiteSettings()
const metaDescription = description ?? settings.description

const ROBOTS_INDEX = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'
const ROBOTS_NOINDEX = 'noindex, follow'

const canonicalHref = noindex ? undefined : canonicalUrl(canonical, siteConfig.url)
const robots = noindex ? ROBOTS_NOINDEX : ROBOTS_INDEX
const ogImageHref = new URL(ogImage.src, siteConfig.url).href
const isArticle = ogType === 'article'
const jsonLdBlocks = (Array.isArray(jsonLd) ? jsonLd : [jsonLd]).map((node) =>
  JSON.stringify(node).replace(/</g, '\\u003c'),
)
---

<!doctype html>
<html lang={siteConfig.lang} class="motion-safe:scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    <meta name="robots" content={robots} />
    {canonicalHref && <link rel="canonical" href={canonicalHref} />}

    <Font cssVariable="--font-big-shoulders" preload />
    <Font cssVariable="--font-hanken" preload={[{ style: 'normal' }]} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content={siteConfig.themeColor} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:locale" content={siteConfig.locale} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    {canonicalHref && <meta property="og:url" content={canonicalHref} />}
    <meta property="og:image" content={ogImageHref} />
    <meta property="og:image:width" content={String(ogImage.width)} />
    <meta property="og:image:height" content={String(ogImage.height)} />
    {ogImage.alt && <meta property="og:image:alt" content={ogImage.alt} />}
    {
      isArticle && publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
      )
    }
    {isArticle && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLdBlocks.map((block) => <script type="application/ld+json" is:inline set:html={block} />)}

    <slot name="head" />
  </head>

  <body class="bg-paper text-ink flex min-h-dvh flex-col font-sans antialiased">
    <a
      href={`#${MAIN_ID}`}
      class="bg-larch outline-larch text-surface sr-only rounded-sm font-medium focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-60 focus:px-4 focus:py-2"
    >
      {siteConfig.header.labels.skipToContent}
    </a>
    <ConsentBanner />
    <Header />
    <main id={MAIN_ID} tabindex="-1" class="flex flex-1 flex-col outline-none">
      <slot />
    </main>
    <Footer />
    <ChatPanel />
  </body>
</html>
